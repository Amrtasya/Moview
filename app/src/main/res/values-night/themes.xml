<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Dark mode theme — colorPrimary sama dengan light agar konsisten -->
    <style name="Theme.MoviewApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">#00E5A8</item>
        <item name="colorPrimaryVariant">#00E5A8</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.MoviewApp.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#00E5A8</item>
        <item name="colorPrimaryVariant">#00E5A8</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="materialButtonStyle">@style/Widget.MoviewApp.Button</item>
    </style>

    <style name="Widget.MoviewApp.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@null</item>
    </style>

</resources>